inst the robot's own TCP proprioception; object targets come from RGB-D.\nEach executed command is saved for the record in actions/.\n\"\"\"\nfrom pathlib import Path\nimport argparse, json\nimport numpy as np\nfrom scipy.spatial.transform import Rotation as R\nfrom scipy.optimize import least_squares\nfrom rcb_client import Robot\nfrom geometry import fk\nOUT=Path('/app/output')\nLIMITS=np.array([[-2.8973,2.8973],[-1.7628,1.7628],[-2.8973,2.8973],[-3.0718,-.0698],[-2.8973,2.8973],[-.0175,3.7525],[-2.8973,2.8973]])\nDOWN=np.array([[0.,1,0],[1,0,0],[0,0,-1]])\n\ndef ik(p, rot, seed):\n def err(q):\n  T=fk(q)\n  return np.r_[(T[:3,3]-p)*5,R.from_matrix(rot@T[:3,:3].T).as_rotvec(),(q-seed)*.002]\n sol=least_squares(err,seed,bounds=(LIMITS[:,0]+.001,LIMITS[:,1]-.001),xtol=1e-11,ftol=1e-11,gtol=1e-11,max_nfev=500)\n if np.linalg.norm(fk(sol.x)[:3,3]-p)>.003: raise ValueError(f'IK error {sol.fun}')\n return sol.x\n\ndef state(obs): return np.array(obs.meta['proprio']['now'])\n\ndef run_move(r,p,fingers,secs,label,yaw=0):\n obs=r.get_obs(cameras=[],video='none'); s=state(obs); q=s[:7]\n rot=R.from_euler('z',yaw).as_matrix()@DOWN\n target=ik(np.array(p),rot,q)\n n=max(int(secs*10),int(np.max(abs(target-q))/.025))\n if n>90: raise ValueError('motion exceeds safe chunk; use waypoint')\n rows=np.linspace(np.r_[q,s[14:16]],np.r_[target,fingers,fingers],n)\n return execute(r,rows,label)\n\ndef execute(r,rows,label):\n (OUT/'actions').mkdir(exist_ok=True)\n i=len(list((OUT/'actions').glob('*.npy')))\n np.save(OUT/'actions'/f'{i:03d}_{label}.npy',rows)\n obs=r.submit('joint_position',rows,dt=.1,cameras=['forward','left','right','wrist'],video='none',include_depth=True,note=label)\n obs.save(str(OUT/label)); print(json.dumps(obs.meta)); return obs\n\nif __name__=='__main__':\n ap=argparse.ArgumentParser();ap.add_argument('label');ap.add_argument('--pos',nargs=3,type=float);ap.add_argument('--fingers',type=float,default=.04);ap.add_argument('--secs',type=float,default=4);ap.add_argument('--yaw',type=float,default=0);ap.add_argument('--grip',action='store_true');args=ap.parse_args();r=Robot()\n if args.pos: run_move(r,args.pos,args.fingers,args.secs,args.label,args.yaw)\n elif args.grip:\n  obs=r.get_obs(cameras=[],video='none');s=state(obs);rows=np.tile(np.r_[s[:7],args.fingers,args.fingers],(int(args.secs*10),1));execute(r,rows,args.label)\n else:\n  obs=r.get_obs(include_depth=True,video='none');obs.save(str(OUT/args.label));print(json.dumps(obs.meta))\nPY\npython /app/output/gen.py approach --pos .28 .275 1.03 --secs 6","status":"ok","wall":0.9,"out":"{\"chunk_id\":\"477264\",\"wall_time_seconds\":0.747874016,\"exit_code\":1,\"original_token_count\":124,\"output\":\"Traceback (most recent call last):\\n  File \\\"/app/output/gen.py\\\", line 45, in <module>\\n    if args.pos: run_move(r,args.pos,args.fingers,args.secs,args.label,args.yaw)\\n                 ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\\n  File \\\"/app/output/gen.py\\\", line 32, in run_move\\n    if n>90: raise ValueError('motion exceeds safe chunk; use waypoint')\\n             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\\nValueError: motion exceeds safe chunk; use waypoint\\n\"}","n":613,"te":125.7},{"k":"run","t":137.9,"tool":"exec","cmd":"python - <<'PY'\nimport sys;sys.path.insert(0,'/app/output')\nfrom gen import *\ns=np.array(json.load(open('/app/output/initial/meta.json'))['proprio']['now']);print(fk(s[:7])[:3,:3]);\nfor yaw in [0,np.pi]:\n q=ik(np.array([.28,.275,1.03]),R.from_euler('z',yaw).as_matrix()@DOWN,s[:7]);print(yaw,q,q-s[:7])\nPY","status":"ok","wall":1.0,"out":"{\"chunk_id\":\"37be1e\",\"wall_time_seconds\":0.774834478,\"exit_code\":0,\"original_token_count\":122,\"output\":\"[[-0.03491271 -0.99936413  0.00724111]\\n [-0.99779712  0.03444717 -0.05669478]\\n [ 0.0564093  -0.00920452 -0.9983653 ]]\\n0 [-0.09786074  0.69981544 -0.4145938  -1.32782238  0.28538304  1.96943197\\n  0.24939165] [-0.0978637   1.74739962 -0.4177