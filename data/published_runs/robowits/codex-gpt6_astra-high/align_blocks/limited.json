.insert(0, '/opt/tools')\nfrom rcb_client import Robot\nOUT=pathlib.Path('/app/output')\nr=Robot()\nspec=r.spec()\n\ndef save(res,label):\n    res.save(str(OUT/label))\n    (OUT/'latest.json').write_text(json.dumps(res.meta))\n    print(json.dumps({k:res.meta.get(k) for k in ['done','reason','calls','control_steps','time_left_s','plan','clipped','stopped']}))\n    print('TCP',res.group('tcp_pose',now=True).tolist())\n    print('grip',res.group('gripper_opening',now=True).tolist())\n\ndef move(arm,xyz,quat=None,grip=.09,duration=3.,execute=True):\n    obs=r.get_obs()\n    now=np.array(obs.meta['proprio']['now'])\n    tcp=now[16:30].reshape(2,7)\n    side=0 if arm=='R' else 1\n    pose=np.r_[xyz, tcp[side,3:] if quat is None else quat]\n    seed=np.r_[now[:7],now[8:15]]\n    ik=r.ik({'Gripper_Tip_'+arm:pose.tolist()},seed=seed)\n    print('IK',json.dumps(ik))\n    if not ik['ok'] or not execute:return\n    start=now[:16].copy(); target=now[30:46].copy()\n    j=0 if arm=='R' else 8\n    target[j:j+7]=ik['q'][side*7:side*7+7]; target[j+7]=grip\n    n=int(round(duration/.1)); a=np.linspace(start,target,n)\n    # Smooth velocity at both ends.\n    t=np.linspace(0,1,n); a=start+(target-start)*(3*t*t-2*t*t*t)[:,None]\n    entry={'type':'joint_position','actions':a.tolist(),'dt':.1,'arm':arm,'pose':pose.tolist(),'grip':grip}\n    with open(OUT/'actions.jsonl','a') as f:f.write(json.dumps(entry)+'\\n')\n    res=r.submit('joint_position',a,dt=.1,video='mp4',depth=True)\n    save(res,'act%03d'%res.meta['calls'])\n\nif __name__=='__main__':\n    cmd=sys.argv[1] if len(sys.argv)>1 else 'obs'\n    if cmd in ['move','ik']:\n        args=json.loads(sys.argv[2]); move(**args,execute=cmd=='move')\n    elif cmd=='obs':save(r.get_obs(depth=True),'obs')\n    elif cmd=='watch':save(r.get_obs(seconds=float(sys.argv[2]),depth=True,video='mp4'),'watch')\n    elif cmd=='status':print(r.status())\nPY\npython /app/output/gen.py ik '{\"arm\":\"L\",\"xyz\":[0.6254,0.2904,0.99]}'","status":"ok","w